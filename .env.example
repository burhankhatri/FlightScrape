# ============== Required for the parser ==============
ANTHROPIC_API_KEY=

# ============== Optional fallback search provider ==============
# Free 2000 calls/month at https://developers.amadeus.com/
# Without these, only Google Flights direct HTTP is used.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ============== Optional cache (recommended for Vercel) ==============
# Free at https://upstash.com/ — Redis with 10k requests/day free tier.
# Without these, cache is in-process (works on localhost, useless on Vercel serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
